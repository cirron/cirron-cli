#!/usr/bin/env node

const path = require('path');
const fs = require('fs');

// Check if we're in development (source) or production (dist)
const isDev = fs.existsSync(path.join(__dirname, '..', 'src'));
const entryPoint = isDev 
  ? path.join(__dirname, '..', 'src', 'index.ts')
  : path.join(__dirname, '..', 'dist', 'index.js');

if (isDev) {
  // Use ts-node for development
  try {
    // Add the CLI's node_modules to the module search path
    const Module = require('module');
    const cliNodeModules = path.join(__dirname, '..', 'node_modules');
    const originalPaths = Module._nodeModulePaths(process.cwd());
    Module._nodeModulePaths = function() {
      return [cliNodeModules, ...originalPaths];
    };

    // Register ts-node with proper configuration
    require('ts-node').register({
      project: path.join(__dirname, '..', 'tsconfig.json'),
      transpileOnly: true,
      compilerOptions: {
        module: 'commonjs'
      }
    });

    require(entryPoint);
  } catch (error) {
    console.error('Development mode requires ts-node. Run: npm install -g ts-node');
    console.error('Error details:', error.message);
    process.exit(1);
  }
} else {
  // Use compiled JS for production
  try {
    require(entryPoint);
  } catch (error) {
    console.error('Error loading Cirron CLI:', error.message);
    process.exit(1);
  }
}