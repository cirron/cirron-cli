{
  "name": "cirron-cli",
  "version": "0.0.0",
  "description": "Official CLI tool for Cirron - build and deploy with ease",
  "main": "dist/index.js",
  "bin": {
    "cirron": "./bin/cirron"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:binaries": "npm run build && pkg dist/index.js --out-path binaries",
    "build:all": "npm run build && pkg dist/index.js --targets node18-linux-x64,node18-macos-x64,node18-macos-arm64,node18-win-x64 --out-path binaries",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "cirron",
    "cli",
    "build",
    "deploy",
    "developer-tools",
    "devops",
    "automation"
  ],
  "author": "Cirron Engineering <engineering@cirron.com>",
  "license": "MIT",
  "homepage": "https://github.com/cirron/cirron-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cirron/cirron-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cirron/cirron-cli/issues"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "templates/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@types/form-data": "^2.2.1",
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "form-data": "^4.0.3",
    "fs-extra": "^11.1.1",
    "inquirer": "^9.2.12",
    "node-fetch": "^3.3.2",
    "ora": "^5.4.1",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.2",
    "@types/inquirer": "^9.0.4",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@types/semver": "^7.5.4",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "preferGlobal": true,
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "templates/**/*"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-macos-arm64",
      "node18-win-x64"
    ]
  }
}
