    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.5",
    "inquirer": "^13.4.3",
    "js-yaml": "^4.2.0",
    "minimatch": "^10.2.5",
    "node-fetch": "^3.3.2",
    "open": "^11.0.0",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@auto-it/npm": "^11.3.6",
    "@biomejs/biome": "^2.4.16",
    "@types/fs-extra": "^11.0.4",
    "@types/iarna__toml": "^2.0.5",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.8",
    "auto": "^11.3.6",
    "semver": "^7.8.1",
