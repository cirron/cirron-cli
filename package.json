{
  "name": "cirron-cli",
  "version": "0.0.0",
  "description": "Official CLI tool for Cirron - build and deploy with ease",
  "main": "dist/index.js",
  "bin": {
    "cirron": "./bin/cirron"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:binaries": "npm run build && nexe dist/index.js -o binaries/cirron",
    "build:all": "npm run build && npm run build:linux && npm run build:macos-x64 && npm run build:macos-arm64 && npm run build:win",
    "build:linux": "nexe dist/index.js -t linux-x64-22.13.0 -o binaries/cirron-linux-x64",
    "build:macos-x64": "nexe dist/index.js -t mac-x64-22.13.0 -o binaries/cirron-macos-x64",
    "build:macos-arm64": "nexe dist/index.js -t mac-arm64-22.13.0 -o binaries/cirron-macos-arm64",
    "build:win": "nexe dist/index.js -t windows-x64-22.13.0 -o binaries/cirron-win-x64.exe",
    "bump-deps": "npx npm-check-updates --deep -u && npm install",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "cirron",
    "cli",
    "build",
    "deploy",
    "developer-tools",
    "devops",
    "automation"
  ],
  "author": "Cirron Engineering <engineering@cirron.com>",
  "license": "MIT",
  "homepage": "https://github.com/cirron/cirron-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cirron/cirron-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cirron/cirron-cli/issues"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "templates/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@types/form-data": "^2.5.2",
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "form-data": "^4.0.5",
    "fs-extra": "^11.3.2",
    "inquirer": "^13.0.1",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.1.1",
    "node-fetch": "^3.3.2",
    "open": "^11.0.0",
    "ora": "^9.0.0",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nexe": "^4.0.0-rc.6",
    "prettier": "^3.7.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "preferGlobal": true
}
