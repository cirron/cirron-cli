    "typescript": "^6.0.3",
    "ultracite": "^7.8.1",
    "vitest": "^4.1.6"
  },
  "name": "@cirron/cli",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "bump-deps": "npx npm-check-updates --deep -u && npm install",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix"
  },
  "version": "0.1.0",
  "description": "Official CLI for Cirron, providing streamlined commands for building, deploying, and managing ML models on and off the platform.",
  "main": "dist/index.js",
  "bin": {
    "cirron": "bin/cirron"
  },
  "keywords": [
    "cirron",
    "cli",
    "build",
    "deploy",
    "developer-tools",
    "devops",
    "automation"
  ],
  "author": "Cirron DX <dx@cirron.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cirron/cirron-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cirron/cirron-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cirron/cirron-cli/issues"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "preferGlobal": true,
  "publishConfig": {
    "access": "public"
  }
