{
  "name": "@cirron/cli",
  "version": "0.2.0",
  "description": "Official CLI for Cirron, providing streamlined commands for building, deploying, and managing ML models on and off the platform.",
  "keywords": [
    "cirron",
    "cli",
    "build",
    "deploy",
    "developer-tools",
    "devops",
    "automation"
  ],
  "homepage": "https://github.com/cirron/cirron-cli#readme",
  "bugs": {
    "url": "https://github.com/cirron/cirron-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cirron/cirron-cli.git"
  },
  "license": "Apache-2.0",
  "author": "Cirron DX <dx@cirron.com>",
  "main": "dist/index.js",
  "bin": {
    "cirron": "bin/cirron"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "bump-deps": "npx npm-check-updates --deep -u && npm install",
    "contracts:check": "node scripts/contracts-check.mjs",
    "dev": "tsx src/index.ts",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@dsnp/parquetjs": "~1.8.9",
    "@iarna/toml": "^2.2.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.1",
    "inquirer": "^14.2.2",
    "js-yaml": "^5.4.2",
    "minimatch": "^10.2.6",
    "open": "^11.0.4",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@auto-it/npm": "^11.3.6",
    "@biomejs/biome": "^2.5.15",
    "@types/fs-extra": "^11.0.4",
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "auto": "^11.3.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "preferGlobal": true,
  "publishConfig": {
    "access": "public"
  }
}
